# Intalent Algeria — Environment Configuration Template
# Copy this file to .env and fill in real credentials when moving from Sandbox to Production.
# Never commit real API keys or secrets to version control.

PORT=8000
INTALENT_SECRET_KEY=replace-with-a-64-char-random-cryptographic-secret

# --- Gemini API Key (Google AI Studio — for Gemini 3.8 Flash AI Copilot) ---
GEMINI_API_KEY=

# --- Social OAuth 2.0 Providers (Optional — UI displays setup instructions if omitted) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/facebook/callback

# --- Algerian Payment Gateway (SATIM CIB / Edahabia E-Payment) ---
# By default, the platform operates in Sandbox Mode (`payment_sandbox_mode=true`).
SATIM_MERCHANT_USERNAME=
SATIM_MERCHANT_PASSWORD=
SATIM_TERMINAL_ID=
SATIM_API_BASE_URL=https://test.satim.dz/payment/rest

# --- Transactional Email (SMTP) ---
SMTP_HOST=smtp.example.dz
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@intalent.dz
